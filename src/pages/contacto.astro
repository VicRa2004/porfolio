---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import personal from '../data/personal.json';
import services from '../data/services.json';
---

<Layout
  title={`Contacto — ${personal.name}`}
  description="Escríbeme para cotizar un proyecto freelance o hacer una consulta profesional."
>
  <Header />

  <main id="contenido" class="container page">
    <div class="intro">
      <p class="eyebrow reveal" style="--i: 0">Contacto</p>
      <h1 class="title reveal" style="--i: 1">Trabajemos juntos<span class="dot">.</span></h1>
      <p class="lead reveal" style="--i: 2">
        ¿Tienes una idea, necesitas un servicio freelance o quieres hacerme una consulta? Cuéntame y te respondo pronto.
      </p>

      <dl class="details reveal" style="--i: 3">
        <div>
          <dt class="eyebrow">Correo</dt>
          <dd><a href={`mailto:${personal.email}`} class="link">{personal.email}</a></dd>
        </div>
        <div>
          <dt class="eyebrow">Ubicación</dt>
          <dd>{personal.location}</dd>
        </div>
        <div>
          <dt class="eyebrow">Redes</dt>
          <dd>
            <ul role="list" class="socials">
              {personal.socials.map((social) => (
                <li>
                  <a href={social.url} target="_blank" rel="noopener noreferrer" class="link">
                    <Icon name={`brand:${social.icon}`} size={15} />
                    {social.name}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <div class="panel reveal" style="--i: 2">
      <div id="success" class="success" hidden tabindex="-1">
        <Icon name="circle-check" size={40} />
        <h2>Mensaje enviado</h2>
        <p>Gracias por escribirme. Te responderé lo antes posible para hablar de tu proyecto.</p>
        <a href="/" class="btn btn-ghost">Volver al inicio</a>
      </div>

      <form id="contact-form" class="form" novalidate>
        <input type="hidden" name="access_key" value={personal.web3forms_key} />
        <input type="hidden" name="subject" value="Nuevo contacto desde tu portafolio" />
        <input type="hidden" name="from_name" value={personal.name} />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="row">
          <div class="field">
            <label for="name">Nombre</label>
            <input type="text" id="name" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>
        </div>

        <div class="row">
          <div class="field">
            <label for="phone">Teléfono / WhatsApp <span class="optional">(opcional)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="service">Servicio de interés</label>
            <select id="service" name="service">
              <option value="general">Consulta general / otro</option>
              {services.map((service) => <option value={service.id}>{service.title}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="6" placeholder="Cuéntame sobre tu idea, objetivos o dudas…" required></textarea>
        </div>

        <p id="form-error" class="error" role="alert" hidden></p>

        <button type="submit" class="btn btn-primary submit">
          <span class="label">Enviar mensaje</span>
          <Icon name="send" size={18} class="send" />
          <Icon name="loader-circle" size={18} class="spinner" />
        </button>
      </form>
    </div>
  </main>

  <Footer cta={false} />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('success');
  const errorBox = document.getElementById('form-error');
  const select = document.getElementById('service') as HTMLSelectElement | null;

  // Preselecciona el servicio si viene en la URL (?servicio=landing-pages)
  const requested = new URLSearchParams(location.search).get('servicio');
  if (select && requested && [...select.options].some((option) => option.value === requested)) {
    select.value = requested;
  }

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorBox) errorBox.hidden = true;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector('.label');
    button?.setAttribute('aria-busy', 'true');
    if (button) button.disabled = true;
    if (label) label.textContent = 'Enviando…';

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'No se pudo enviar el formulario.');
      }

      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.focus();
      }
    } catch (error) {
      console.error(error);
      showError(
        error instanceof Error && error.message
          ? error.message
          : 'Ocurrió un error al enviar el mensaje. Inténtalo de nuevo.',
      );
      button?.removeAttribute('aria-busy');
      if (button) button.disabled = false;
      if (label) label.textContent = 'Enviar mensaje';
    }
  });
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  @media (min-width: 960px) {
    .page {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-9);
      align-items: start;
    }
  }

  .title {
    margin-top: var(--space-4);
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .dot {
    color: var(--accent);
  }

  .lead {
    margin-top: var(--space-5);
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .details {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .details dt {
    margin-bottom: var(--space-1);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .panel {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .form {
    display: grid;
    gap: var(--space-5);
  }

  .row {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 600px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .optional {
    font-weight: 400;
    color: var(--subtle);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--subtle);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  textarea {
    resize: vertical;
  }

  .error {
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in oklab, var(--danger) 35%, transparent);
    border-radius: var(--radius-sm);
    color: var(--danger);
    font-size: 0.9rem;
  }

  .submit {
    justify-self: start;
  }

  .submit .spinner,
  .submit[aria-busy='true'] .send {
    display: none;
  }

  .submit[aria-busy='true'] .spinner {
    display: inline-block;
    animation: spin 0.9s linear infinite;
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .success {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    outline: none;
  }

  .success[hidden] {
    display: none;
  }

  .success .icon {
    color: var(--success);
  }

  .success h2 {
    font-size: 1.75rem;
  }

  .success p {
    color: var(--muted);
    max-width: 44ch;
  }
</style>
