---
import Icon from './Icon.astro';
import personal from '../data/personal.json';

const links = [
  { href: '/#proyectos', section: 'proyectos', label: 'Proyectos' },
  { href: '/#experiencia', section: 'experiencia', label: 'Experiencia' },
  { href: '/#habilidades', section: 'habilidades', label: 'Habilidades' },
  { href: '/#servicios', section: 'servicios', label: 'Servicios' },
  { href: '/contacto', section: null, label: 'Contacto' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" data-header>
  <div class="header-shell" data-header-shell>
    <div class="container bar">
      <a href="/" class="brand" data-magnetic-brand aria-label={`${personal.name}, inicio`}>
        <span class="mark" data-magnetic-mark aria-hidden="true">
          <span class="mark-text">vr</span>
        </span>
        <span class="brand-name">{personal.shortName}</span>
      </a>

      <nav class="nav" aria-label="Principal">
        <ul role="list" data-nav-list>
          <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                data-section={link.section ?? undefined}
                aria-current={current === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="actions">
        <button type="button" class="palette-trigger" data-open-palette aria-label="Abrir paleta de comandos" aria-keyshortcuts="Control+K">
          <Icon name="search" size={16} />
          <kbd aria-hidden="true">Ctrl K</kbd>
        </button>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Cambiar a tema oscuro">
          <Icon name="moon" class="moon" />
          <Icon name="sun" class="sun" />
        </button>
        <a href={personal.cv} class="btn btn-ghost cv" download="CV - Víctor Raúl García García.pdf">
          <Icon name="download" size={16} />
          <span>CV</span>
        </a>
      </div>
    </div>

    <div class="progress-track" aria-hidden="true">
      <div class="progress-bar" data-scroll-progress></div>
    </div>
  </div>
</header>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');
  const shell = document.querySelector<HTMLElement>('[data-header-shell]');
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const toggle = document.getElementById('theme-toggle');

  // 1. Cambio de tema con onda circular nativa (View Transitions API)
  const syncThemeLabel = () => {
    const dark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
  };

  const applyTheme = () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    syncThemeLabel();
  };

  syncThemeLabel();
  toggle?.addEventListener('click', () => {
    const startVT = (document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> } })
      .startViewTransition;

    if (!startVT || reducedMotion) {
      applyTheme();
      return;
    }

    const rect = toggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const maxRadius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));

    root.classList.add('theme-transitioning');
    const transition = startVT.call(document, applyTheme);

    transition.ready
      .then(() => {
        root.animate(
          {
            clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${maxRadius}px at ${x}px ${y}px)`],
          },
          {
            duration: 520,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      })
      .catch(() => {});

    transition.finished.finally(() => {
      root.classList.remove('theme-transitioning');
    });
  });

  // 2. Dynamic Island al hacer scroll + barra de progreso de lectura
  let scrollRaf = 0;
  const updateScroll = () => {
    scrollRaf = 0;
    const y = window.scrollY;
    if (header) header.dataset.scrolled = y > 28 ? 'true' : 'false';

    if (progressBar) {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, y / scrollable)) : 0;
      progressBar.style.transform = `scaleX(${ratio})`;
    }
  };

  const onScroll = () => {
    if (!scrollRaf) scrollRaf = requestAnimationFrame(updateScroll);
  };

  updateScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  // 3. Spotlight que sigue al cursor en la cápsula del header
  if (shell && !reducedMotion) {
    shell.addEventListener('pointermove', (e) => {
      const rect = shell.getBoundingClientRect();
      shell.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      shell.style.setProperty('--my', `${e.clientY - rect.top}px`);
      shell.dataset.hover = 'true';
    });
    shell.addEventListener('pointerleave', () => {
      shell.dataset.hover = 'false';
    });
  }

  // 4. Emblema `vr` magnético al pasar el cursor
  const brand = document.querySelector<HTMLElement>('[data-magnetic-brand]');
  const mark = document.querySelector<HTMLElement>('[data-magnetic-mark]');
  if (brand && mark && !reducedMotion) {
    brand.addEventListener('pointermove', (e) => {
      const rect = mark.getBoundingClientRect();
      const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.22;
      const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.22;
      const cx = Math.max(-5, Math.min(5, dx));
      const cy = Math.max(-5, Math.min(5, dy));
      mark.style.transform = `translate(${cx}px, ${cy}px) scale(1.06)`;
    });
    brand.addEventListener('pointerleave', () => {
      mark.style.transform = '';
    });
  }

  // 5. Píldora elástica en navegación + Scroll-Spy automático
  const navList = document.querySelector<HTMLElement>('[data-nav-list]');
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

  if (navList && indicator && navLinks.length > 0) {
    let activeLink: HTMLAnchorElement | null = navLinks.find((a) => a.getAttribute('aria-current') === 'page') ?? null;
    let hoveredLink: HTMLAnchorElement | null = null;

    const placeIndicator = (target: HTMLAnchorElement | null) => {
      if (!target) {
        indicator.style.opacity = '0';
        return;
      }
      indicator.style.opacity = '1';
      indicator.style.width = `${target.offsetWidth}px`;
      indicator.style.height = `${target.offsetHeight}px`;
      indicator.style.transform = `translate(${target.offsetLeft}px, ${target.offsetTop}px)`;
    };

    const syncActiveClasses = () => {
      navLinks.forEach((a) => {
        a.dataset.active = a === activeLink ? 'true' : 'false';
      });
      placeIndicator(hoveredLink ?? activeLink);
    };

    navLinks.forEach((link) => {
      link.addEventListener('pointerenter', () => {
        hoveredLink = link;
        placeIndicator(link);
      });
      link.addEventListener('focus', () => {
        hoveredLink = link;
        placeIndicator(link);
      });
      link.addEventListener('blur', () => {
        hoveredLink = null;
        placeIndicator(activeLink);
      });
    });

    navList.addEventListener('pointerleave', () => {
      hoveredLink = null;
      placeIndicator(activeLink);
    });

    // Scroll-Spy para las secciones de la página principal
    const sectionLinks = navLinks
      .filter((a) => a.dataset.section)
      .map((link) => ({ link, el: document.getElementById(link.dataset.section!) }))
      .filter((item): item is { link: HTMLAnchorElement; el: HTMLElement } => item.el !== null);

    if (sectionLinks.length > 0) {
      let spyRaf = 0;
      const updateSpy = () => {
        spyRaf = 0;
        const triggerY = window.scrollY + window.innerHeight * 0.34;
        let currentSection: HTMLAnchorElement | null = null;
        for (const { link, el } of sectionLinks) {
          if (el.offsetTop <= triggerY) currentSection = link;
        }
        if (currentSection !== activeLink) {
          activeLink = currentSection;
          syncActiveClasses();
        }
      };

      const onSpyScroll = () => {
        if (!spyRaf) spyRaf = requestAnimationFrame(updateSpy);
      };

      updateSpy();
      window.addEventListener('scroll', onSpyScroll, { passive: true });
    }

    syncActiveClasses();
    new ResizeObserver(() => placeIndicator(hoveredLink ?? activeLink)).observe(navList);
    document.fonts.ready.then(() => placeIndicator(hoveredLink ?? activeLink));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-top: 0;
    transition: padding 0.45s var(--ease-out);
  }

  .header-shell {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin-inline: auto;
    background-color: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line);
    transition:
      max-width 0.48s var(--ease-out),
      border-radius 0.48s var(--ease-out),
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.48s var(--ease-out);
  }

  /* Spotlight que sigue al cursor */
  .header-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in oklab, var(--accent) 16%, transparent),
      transparent 70%
    );
    transition: opacity 0.35s ease;
  }

  .header-shell[data-hover='true']::before {
    opacity: 1;
  }

  .bar {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'brand . actions'
      'nav nav nav';
    align-items: center;
    column-gap: var(--space-5);
    min-height: 64px;
    transition: min-height 0.4s var(--ease-out), padding-inline 0.4s var(--ease-out);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
  }

  .mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s ease,
      border-radius 0.3s var(--ease-out);
  }

  .mark::after {
    content: '';
    position: absolute;
    inset: -40%;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.42) 50%, transparent 65%);
    transform: translateX(-110%);
    transition: transform 0.6s var(--ease-out);
  }

  .brand:hover .mark {
    border-radius: 10px;
    box-shadow: 0 4px 16px -2px color-mix(in oklab, var(--accent) 55%, transparent);
  }

  .brand:hover .mark::after {
    transform: translateX(110%);
  }

  .nav {
    grid-area: nav;
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scrollbar-width: none;
    border-top: 1px solid var(--line);
  }

  .nav ul {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--gutter);
    white-space: nowrap;
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid color-mix(in oklab, var(--accent) 24%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.36s var(--ease-out),
      width 0.36s var(--ease-out),
      height 0.36s var(--ease-out),
      opacity 0.22s ease;
  }

  .nav a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav a:hover,
  .nav a[data-active='true'],
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav a[data-active='true'],
  .nav a[aria-current='page'] {
    font-weight: 500;
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .palette-trigger {
    display: none; /* en pantallas angostas no cabe y sin teclado aporta poco */
    align-items: center;
    gap: var(--space-2);
    height: 38px;
    padding-inline: 0.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  @media (min-width: 480px) {
    .palette-trigger {
      display: inline-flex;
    }
  }

  .palette-trigger:hover {
    color: var(--ink);
    background-color: var(--accent-soft);
  }

  .palette-trigger kbd {
    display: none;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (min-width: 1000px) {
    .palette-trigger kbd {
      display: inline;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.3s var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--ink);
    background-color: var(--accent-soft);
    transform: rotate(15deg);
  }

  .theme-toggle:active {
    transform: scale(0.92) rotate(30deg);
  }

  .theme-toggle .sun,
  :global([data-theme='dark']) .theme-toggle .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .sun {
    display: inline-block;
  }

  .cv {
    min-height: 36px;
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }

  /* Barra ultrafina de progreso de lectura */
  .progress-track {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    pointer-events: none;
  }

  .progress-bar {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 65%, transparent);
    will-change: transform;
  }

  @media (min-width: 760px) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav actions';
      min-height: 72px;
    }

    .nav {
      margin: 0;
      border: 0;
      justify-self: center;
    }

    .nav ul {
      padding: 0;
      gap: var(--space-1);
    }

    /* Dynamic Island flotante al hacer scroll */
    .header[data-scrolled='true'] {
      padding-top: 0.7rem;
      padding-inline: var(--gutter);
    }

    .header[data-scrolled='true'] .header-shell {
      max-width: 920px;
      border-radius: 999px;
      border: 1px solid color-mix(in oklab, var(--accent) 20%, var(--line));
      background-color: color-mix(in oklab, var(--surface) 80%, transparent);
      backdrop-filter: blur(18px) saturate(165%);
      -webkit-backdrop-filter: blur(18px) saturate(165%);
      box-shadow:
        0 10px 30px -12px rgba(0, 0, 0, 0.22),
        0 0 0 1px color-mix(in oklab, var(--accent) 8%, transparent) inset;
    }

    .header[data-scrolled='true'] .bar {
      min-height: 58px;
      padding-inline: 1rem 0.85rem;
    }
  }
</style>
