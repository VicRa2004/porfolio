---
import Icon from './Icon.astro';
import personal from '../data/personal.json';

const links = [
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/#habilidades', label: 'Habilidades' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${personal.name}, inicio`}>
      <span class="mark" aria-hidden="true">vr</span>
      <span class="brand-name">{personal.shortName}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Cambiar a tema oscuro">
        <Icon name="moon" class="moon" />
        <Icon name="sun" class="sun" />
      </button>
      <a href={personal.cv} class="btn btn-ghost cv" download="CV - Víctor Raúl García García.pdf">
        <Icon name="download" size={16} />
        <span>CV</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
  };

  sync();
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    sync();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in oklab, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'brand . actions'
      'nav nav nav';
    align-items: center;
    column-gap: var(--space-5);
    min-height: 64px;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .nav {
    grid-area: nav;
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scrollbar-width: none;
    border-top: 1px solid var(--line);
  }

  .nav ul {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-3) var(--gutter);
    white-space: nowrap;
  }

  .nav a {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.4em;
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--ink);
    background-color: var(--accent-soft);
  }

  .theme-toggle .sun,
  :global([data-theme='dark']) .theme-toggle .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .sun {
    display: inline-block;
  }

  .cv {
    min-height: 36px;
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }

  @media (min-width: 760px) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav actions';
      min-height: 72px;
    }

    .nav {
      margin: 0;
      border: 0;
      justify-self: center;
    }

    .nav ul {
      padding: 0;
      gap: var(--space-6);
    }
  }
</style>
