---
import skills from '../data/skills.json';
---

<section id="habilidades" class="section container" aria-labelledby="habilidades-title">
  <header class="section-head">
    <span class="section-index">03</span>
    <h2 id="habilidades-title" class="section-title">Habilidades</h2>
    <p class="section-lead">Herramientas con las que he entregado proyectos, no una lista de deseos.</p>
  </header>

  <dl class="skills">
    {skills.map((group) => (
      <div class="row">
        <dt>{group.category}</dt>
        <dd>
          <ul role="list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .skills {
    display: grid;
  }

  .row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .row:first-child {
    padding-top: 0;
  }

  .row:last-child {
    border-bottom: 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--subtle);
    padding-top: 0.15rem;
  }

  dd ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
  }

  dd li {
    color: var(--ink);
  }

  dd li:not(:last-child)::after {
    content: '/';
    margin-inline: 0.55rem;
    color: var(--line);
  }

  @media (min-width: 680px) {
    .row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
