---
import Icon from './Icon.astro';
import services from '../data/services.json';
---

<section id="servicios" class="section container" aria-labelledby="servicios-title">
  <header class="section-head">
    <span class="section-index">05</span>
    <h2 id="servicios-title" class="section-title">Servicios</h2>
    <p class="section-lead">Trabajo freelance para negocios, eventos y otros equipos de desarrollo.</p>
  </header>

  <ul role="list" class="services">
    {services.map((service) => (
      <li class="service">
        <div>
          <h3 class="service-title">{service.title}</h3>
          <p class="description">{service.description}</p>
        </div>
        <ul role="list" class="features">
          {service.features.map((feature) => (
            <li>
              <Icon name="check" size={16} />
              {feature}
            </li>
          ))}
        </ul>
        <a href={`/contacto?servicio=${service.id}`} class="link quote">
          Cotizar <span class="sr-only">{service.title}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .services {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 760px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--bg);
    transition: background-color 0.25s ease;
  }

  .service:hover {
    background: var(--surface);
  }

  .service-title {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .description {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .features {
    display: grid;
    gap: var(--space-2);
    font-size: 0.9rem;
  }

  .features li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }

  .features .icon {
    color: var(--accent);
    transform: translateY(3px);
  }

  .quote {
    margin-top: auto;
    font-size: 0.9rem;
  }

  .quote .icon {
    transition: transform 0.2s var(--ease-out);
  }

  .quote:hover .icon {
    transform: translateX(3px);
  }
</style>
