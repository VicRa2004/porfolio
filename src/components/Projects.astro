---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import projects from '../data/projects.json';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const imageFor = (file: string | null) => (file ? images[`../assets/projects/${file}`]?.default : undefined);

const groups = [
  { id: 'general', title: 'Productos y clientes' },
  { id: 'programmer', title: 'Para programadores' },
];

const initials = (title: string) =>
  title
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0])
    .join('');
---

<section id="proyectos" class="section container" aria-labelledby="proyectos-title">
  <header class="section-head">
    <span class="section-index">01</span>
    <h2 id="proyectos-title" class="section-title">Proyectos</h2>
    <p class="section-lead">Una selección de lo que he construido, desde productos para clientes hasta herramientas para otros desarrolladores.</p>
  </header>

  <div class="groups">
    {groups.map((group) => (
      <div class="group">
        <h3 class="eyebrow group-title">{group.title}</h3>
        <ul role="list" class="grid">
          {projects
            .filter((project) => project.category === group.id)
            .map((project) => {
              const image = imageFor(project.image);
              const href = project.link ?? project.repo;
              return (
                <li class="card">
                  <div class="media">
                    {image ? (
                      <Image src={image} alt="" widths={[480, 800, 1100]} sizes="(min-width: 900px) 420px, 100vw" />
                    ) : (
                      <span class="placeholder" aria-hidden="true">{initials(project.title)}</span>
                    )}
                  </div>
                  <div class="content">
                    <h4 class="card-title">
                      {href ? (
                        <a href={href} target="_blank" rel="noopener noreferrer" class="card-link">
                          {project.title}
                          <Icon name="arrow-up-right" size={18} />
                        </a>
                      ) : (
                        project.title
                      )}
                    </h4>
                    <p class="description">{project.description}</p>
                    <ul role="list" class="stack">
                      {project.technologies.map((tech) => <li>{tech}</li>)}
                    </ul>
                    <div class="links">
                      {project.link && (
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class="link">
                          Ver sitio <span class="sr-only">de {project.title}</span>
                        </a>
                      )}
                      {project.repo && (
                        <a href={project.repo} target="_blank" rel="noopener noreferrer" class="link">
                          Código <span class="sr-only">de {project.title}</span>
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: var(--space-8);
  }

  .group-title {
    margin-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
  }

  @media (min-width: 680px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--accent-soft);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s var(--ease-out);
  }

  .card:hover .media img {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--accent);
    background-image: radial-gradient(color-mix(in oklab, var(--accent) 22%, transparent) 1px, transparent 1px);
    background-size: 14px 14px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-size: 1.25rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Toda la tarjeta es clicable sin anidar enlaces */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-link .icon {
    color: var(--subtle);
    transition: transform 0.25s var(--ease-out), color 0.2s ease;
  }

  .card:hover .card-link .icon {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .description {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-5);
    font-size: 0.9rem;
  }
</style>
