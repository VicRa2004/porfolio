---
// Iconos SVG en línea a partir de los sets de Iconify (se resuelven en build, sin JS ni CDN).
import lucide from '@iconify-json/lucide/icons.json';
import simpleIcons from '@iconify-json/simple-icons/icons.json';

interface Props extends astroHTML.JSX.SVGAttributes {
  /** `nombre` para Lucide o `brand:nombre` para Simple Icons. */
  name: string;
  size?: number;
  class?: string;
  /** Texto accesible; si se omite, el icono es decorativo. */
  label?: string;
}

// `rest` incluye el atributo de scope del padre, para que sus estilos alcancen el SVG.
const { name, size = 18, class: className, label, ...rest } = Astro.props;

const [set, iconName] = name.startsWith('brand:') ? [simpleIcons, name.slice(6)] : [lucide, name];
const icon = (set.icons as Record<string, { body: string }>)[iconName];

if (!icon) {
  throw new Error(`Icono no encontrado: ${name}`);
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${set.width ?? 24} ${set.height ?? 24}`}
  width={size}
  height={size}
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={icon.body}
/>
