---
import Icon from './Icon.astro';
import personal from '../data/personal.json';

const lastNames = personal.name.replace(personal.shortName, '').trim();
const firstNames = personal.shortName;
---

<section class="hero container" aria-labelledby="hero-title" data-sky>
  <pre class="sky sky-back" aria-hidden="true"></pre>
  <pre class="sky sky-front" aria-hidden="true"></pre>

  <p class="eyebrow reveal" style="--i: 0">{personal.role} · {personal.location}</p>

  <h1 id="hero-title" class="title reveal" style="--i: 1">
    {firstNames}<br />
    <span class="muted">{lastNames}</span><span class="dot">.</span>
  </h1>

  <div class="body">
    <p class="bio reveal" style="--i: 2">{personal.bio}</p>

    <div class="cta reveal" style="--i: 3">
      <a href={personal.cv} class="btn btn-primary" download="CV - Víctor Raúl García García.pdf">
        <Icon name="download" size={18} />
        Descargar CV
      </a>
      <a href="/contacto" class="btn btn-ghost">
        Hablemos
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>

  <ul role="list" class="meta reveal" style="--i: 4">
    {personal.available && (
      <li class="status">
        <span class="pulse" aria-hidden="true"></span>
        Disponible para proyectos freelance
      </li>
    )}
    {personal.socials.map((social) => (
      <li>
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="social">
          <Icon name={`brand:${social.icon}`} size={15} />
          {social.name}
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  import { createSky, launchComet, renderSky, SYSTEM_COLS, SYSTEM_ROWS, type Sky } from '../scripts/ascii-space';

  const hero = document.querySelector<HTMLElement>('[data-sky]');
  const back = hero?.querySelector<HTMLPreElement>('.sky-back');
  const front = hero?.querySelector<HTMLPreElement>('.sky-front');
  const title = hero?.querySelector<HTMLElement>('.title');

  if (hero && back && front && title) {
    const animate = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = matchMedia('(min-width: 1100px)');
    const FRAME_MS = 1000 / 24;

    let cell = { w: 0, h: 0 };
    let sky: Sky = createSky(0, 0);
    let system: { x: number; y: number } | null = null;
    // Tiempo simulado: se frena al pasar el cursor por el sistema.
    let time = 8;
    let speed = 1;
    let targetSpeed = 1;

    const draw = () => {
      const scene = renderSky(sky, time, system, animate);
      back.textContent = scene.back;
      front.textContent = scene.front;
    };

    const layout = () => {
      const probe = document.createElement('span');
      probe.textContent = '0'.repeat(100);
      back.replaceChildren(probe);
      cell = { w: probe.getBoundingClientRect().width / 100, h: parseFloat(getComputedStyle(back).lineHeight) };
      const [cols, rows] = [Math.ceil(hero.clientWidth / cell.w), Math.ceil(hero.clientHeight / cell.h)];
      sky = createSky(cols, rows, blockedCells(cols, rows));
      const gutter = parseFloat(getComputedStyle(hero).paddingRight);
      system = wide.matches
        ? { x: Math.floor((hero.clientWidth - gutter) / cell.w) - SYSTEM_COLS, y: Math.round(title.offsetTop / cell.h) - 1 }
        : null;
      draw();
    };

    // Celdas que tapa el texto (línea por línea, no la caja entera) y los controles, con un margen de una celda.
    const blockedCells = (cols: number, rows: number) => {
      const blocked = new Uint8Array(cols * rows);
      const origin = hero.getBoundingClientRect();
      const rects = [...hero.querySelectorAll('.eyebrow, .title, .bio, .cta a, .meta li')].flatMap((el) => {
        const range = document.createRange();
        range.selectNodeContents(el);
        return el.matches('a, li') ? [el.getBoundingClientRect()] : [...range.getClientRects()];
      });
      for (const rect of rects) {
        const [x0, x1] = [Math.floor((rect.left - origin.left) / cell.w) - 1, Math.ceil((rect.right - origin.left) / cell.w) + 1];
        const [y0, y1] = [Math.floor((rect.top - origin.top) / cell.h), Math.ceil((rect.bottom - origin.top) / cell.h)];
        for (let y = Math.max(0, y0); y < Math.min(rows, y1); y++) blocked.fill(1, y * cols + Math.max(0, x0), y * cols + Math.min(cols, x1));
      }
      return blocked;
    };

    const cellAt = (event: MouseEvent) => {
      const rect = hero.getBoundingClientRect();
      return { col: (event.clientX - rect.left) / cell.w, row: (event.clientY - rect.top) / cell.h };
    };

    layout();
    document.fonts.ready.then(layout);
    new ResizeObserver(layout).observe(hero);
    // Al acabar la entrada (el texto sube 12px) se vuelven a medir las zonas tapadas, sin mover las estrellas.
    hero.addEventListener('animationend', () => {
      sky.blocked = blockedCells(sky.cols, sky.rows);
      sky.stars = sky.stars.filter((star) => !sky.blocked[star.y * sky.cols + star.x]);
      draw();
    });

    if (animate) {
      let frame = 0;
      let last = performance.now();
      let sinceDraw = 0;
      const tick = (now: number) => {
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        speed += (targetSpeed - speed) * Math.min(1, dt * 3);
        time += dt * speed;
        sinceDraw += dt * 1000;
        if (sinceDraw >= FRAME_MS) {
          sinceDraw = 0;
          draw();
        }
        frame = requestAnimationFrame(tick);
      };
      // Sólo anima mientras el hero se ve.
      new IntersectionObserver(([entry]) => {
        cancelAnimationFrame(frame);
        last = performance.now();
        if (entry.isIntersecting) frame = requestAnimationFrame(tick);
      }).observe(hero);

      hero.addEventListener('pointermove', (event) => {
        const { col, row } = cellAt(event);
        const overSystem =
          system && col >= system.x && col <= system.x + SYSTEM_COLS && row >= system.y && row <= system.y + SYSTEM_ROWS;
        targetSpeed = overSystem ? 0.15 : 1;
      });
      hero.addEventListener('pointerleave', () => (targetSpeed = 1));

      // Clic en el cielo: estrella fugaz desde ese punto.
      hero.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a, button') || String(getSelection())) return;
        const { col, row } = cellAt(event);
        launchComet(sky, col, row, time);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 10vw, 8rem) clamp(3rem, 7vw, 5.5rem);
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 12px;
    white-space: pre;
    user-select: none;
    pointer-events: none;
  }

  .sky-back {
    color: var(--subtle);
    opacity: 0.6;
    /* Se desvanece en los bordes para no cortar el cielo en seco */
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent),
      linear-gradient(to bottom, #000 65%, transparent);
    mask-composite: intersect;
  }

  .sky-front {
    color: var(--accent);
  }

  .title {
    margin-top: var(--space-5);
    font-size: clamp(2.9rem, 1.4rem + 7vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .muted {
    color: var(--subtle);
    font-weight: 500;
  }

  .dot {
    color: var(--accent);
  }

  .body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .bio {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-basis: 100%;
    color: var(--ink);
  }

  @media (min-width: 600px) {
    .status {
      flex-basis: auto;
      margin-right: auto;
    }
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--success) 60%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s ease-out infinite;
    }

    @keyframes pulse {
      70%,
      100% {
        box-shadow: 0 0 0 7px transparent;
      }
    }
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: color 0.2s ease;
  }

  .social:hover {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
