---
import Icon from './Icon.astro';
import personal from '../data/personal.json';

const lastNames = personal.name.replace(personal.shortName, '').trim();
const firstNames = personal.shortName;
---

<section class="hero container" aria-labelledby="hero-title">
  <p class="eyebrow reveal" style="--i: 0">{personal.role} · {personal.location}</p>

  <h1 id="hero-title" class="title reveal" style="--i: 1">
    {firstNames}<br />
    <span class="muted">{lastNames}</span><span class="dot">.</span>
  </h1>

  <div class="body">
    <p class="bio reveal" style="--i: 2">{personal.bio}</p>

    <div class="cta reveal" style="--i: 3">
      <a href={personal.cv} class="btn btn-primary" download="CV - Víctor Raúl García García.pdf">
        <Icon name="download" size={18} />
        Descargar CV
      </a>
      <a href="/contacto" class="btn btn-ghost">
        Hablemos
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>

  <ul role="list" class="meta reveal" style="--i: 4">
    {personal.available && (
      <li class="status">
        <span class="pulse" aria-hidden="true"></span>
        Disponible para proyectos freelance
      </li>
    )}
    {personal.socials.map((social) => (
      <li>
        <a href={social.url} target="_blank" rel="noopener noreferrer" class="social">
          <Icon name={`brand:${social.icon}`} size={15} />
          {social.name}
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 8rem) clamp(3rem, 7vw, 5.5rem);
  }

  .title {
    margin-top: var(--space-5);
    font-size: clamp(2.9rem, 1.4rem + 7vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .muted {
    color: var(--subtle);
    font-weight: 500;
  }

  .dot {
    color: var(--accent);
  }

  .body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .bio {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-basis: 100%;
    color: var(--ink);
  }

  @media (min-width: 600px) {
    .status {
      flex-basis: auto;
      margin-right: auto;
    }
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--success) 60%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s ease-out infinite;
    }

    @keyframes pulse {
      70%,
      100% {
        box-shadow: 0 0 0 7px transparent;
      }
    }
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: color 0.2s ease;
  }

  .social:hover {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
