---
import Icon from './Icon.astro';
import experience from '../data/experience.json';
---

<section id="experiencia" class="section container" aria-labelledby="experiencia-title">
  <header class="section-head">
    <span class="section-index">02</span>
    <h2 id="experiencia-title" class="section-title">Experiencia en proyectos</h2>
    <p class="section-lead">Sistemas reales: tiempo real, apps móviles, plataformas institucionales y trabajo para clientes.</p>
  </header>

  <ol role="list" class="list">
    {experience.map((item, index) => (
      <li class="item">
        <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="body">
          <div class="head">
            <h3 class="item-title">{item.title}</h3>
            <p class="role">{item.role}</p>
          </div>
          <ul class="highlights">
            {item.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <ul role="list" class="stack" aria-label="Tecnologías">
            {item.stack.map((tech) => <li>{tech}</li>)}
          </ul>
          {item.links.length > 0 && (
            <div class="links">
              {item.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="link">
                  <Icon name="brand:github" size={14} />
                  {link.label}
                  <span class="sr-only">de {item.title} (se abre en una pestaña nueva)</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .list {
    display: grid;
  }

  .item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .item:first-child {
    padding-top: 0;
  }

  .item:last-child {
    border-bottom: 0;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--subtle);
    padding-top: 0.3rem;
  }

  .body {
    display: grid;
    gap: var(--space-3);
  }

  .head {
    display: grid;
    gap: var(--space-1);
  }

  .item-title {
    font-size: 1.2rem;
  }

  .role {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .highlights {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .highlights li::marker {
    color: var(--subtle);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: 0.875rem;
  }

  @media (min-width: 680px) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-5);
    }
  }
</style>
