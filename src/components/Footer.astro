---
import Icon from './Icon.astro';
import personal from '../data/personal.json';

interface Props {
  /** Muestra el bloque de llamada a la acción sobre el pie. */
  cta?: boolean;
}

const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  {cta && (
    <div class="container cta">
      <p class="eyebrow">¿Tienes un proyecto en mente?</p>
      <a href={`mailto:${personal.email}`} class="mail">
        {personal.email}
        <Icon name="arrow-up-right" size={28} />
      </a>
      <div class="cta-actions">
        <a href="/contacto" class="btn btn-primary">Ir al formulario</a>
        <a href={personal.cv} class="btn btn-ghost" download="CV - Víctor Raúl García García.pdf">
          <Icon name="download" size={18} />
          Descargar CV
        </a>
      </div>
    </div>
  )}

  <div class="container bottom">
    <p>© {year} {personal.name}</p>
    <ul role="list" class="socials">
      {personal.socials.map((social) => (
        <li>
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            <Icon name={`brand:${social.icon}`} size={18} label={social.name} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }

  .cta {
    padding-block: var(--space-9) var(--space-8);
  }

  .mail {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 0.8rem + 3.6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--line);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }

  .mail:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .mail .icon {
    color: var(--accent);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    font-size: 0.85rem;
    color: var(--subtle);
  }

  .cta + .bottom {
    border-top: 1px solid var(--line);
  }

  .socials {
    display: flex;
    gap: var(--space-2);
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .socials a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
